\par             FUNH3i = FUNH3inc * 0.00001
\par  
\par     logFIMG = BMG / GRB * (ZN - 1) - Log(ZN - GRB) + GRA / GRB * (BMG / GRB - 2 / A * ArMG) * Log(1 + GRB / ZN)
\par             FIMGinc = 10 ^ (logFIMG / 2.303)
