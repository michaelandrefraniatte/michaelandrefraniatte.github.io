\par     'calcul de somme de Xk(1-Kki)racine(aialphai*akalphak)  (avant le 2 dans le calcul du coefficient de fugacit\'e9 de l'esp\'e8ce k)
\par     grAbis = (1 - KH2_MG) * XMGbis * (AH2 * AMG) ^ (1 / 2)
\par     grAsuite = (1 - KH2_CH4) * XCH4bis * (AH2 * ACH4) ^ (1 / 2) + (1 - KH2_NH3) * XNH3bis * (ANH3 * AH2) ^ (1 / 2) + grAbis
\par     ArH2 = (XH2bis) * AH2 + (1 - KH2O_H2) * XH2Obis * (AH2O * AH2) ^ (1 / 2) + (1 - KCO2_H2) * XCO2bis * (ACO2 * AH2) ^ (1 / 2) + (1 - KN2_H2) * XN2bis * (AN2 * AH2) ^ (1 / 2) + (1 - KCO_H2) * XCObis * (ACO * AH2) ^ (1 / 2) + grAsuite
\par     grAbis = (1 - KCO2_MG) * XMGbis * (ACO2 * AMG) ^ (1 / 2)
\par     grAsuite = (1 - KCO2_CH4) * XCH4bis * (ACO2 * ACH4) ^ (1 / 2) + (1 - KCO2_NH3) * XNH3bis * (ANH3 * ACO2) ^ (1 / 2) + grAbis
\par     ArCO2 = (XCO2bis) * ACO2 + (1 - KH2O_HCO2) * XH2Obis * (AH2O * ACO2) ^ (1 / 2) + (1 - KCO2_H2) * XH2bis * (ACO2 * AH2) ^ (1 / 2) + (1 - KN2_CO2) * XN2bis * (AN2 * ACO2) ^ (1 / 2) + (1 - KCO_CO2) * XCObis * (ACO * ACO2) ^ (1 / 2) + grAsuite
\par     grAbis = (1 - KN2_MG) * XMGbis * (AN2 * AMG) ^ (1 / 2)
\par     grAsuite = (1 - KN2_CH4) * XCH4bis * (AN2 * ACH4) ^ (1 / 2) + (1 - KN2_NH3) * XNH3bis * (ANH3 * AN2) ^ (1 / 2) + grAbis
\par     ArN2 = (XN2bis) * AN2 + (1 - KH2O_N2) * XH2Obis * (AH2O * AN2) ^ (1 / 2) + (1 - KN2_H2) * XH2bis * (AN2 * AH2) ^ (1 / 2) + (1 - KN2_CO2) * XCO2bis * (AN2 * ACO2) ^ (1 / 2) + (1 - KN2_CO) * XCObis * (ACO * AN2) ^ (1 / 2) + grAsuite
\par     grAbis = (1 - KH2O_MG) * XMGbis * (AH2O * AMG) ^ (1 / 2)
\par     grAsuite = (1 - KH2O_CH4) * XCH4bis * (AH2O * ACH4) ^ (1 / 2) + (1 - KH2O_NH3) * XNH3bis * (ANH3 * AH2O) ^ (1 / 2) + grAbis
\par     ArH2O = (XH2Obis) * AH2O + (1 - KH2O_H2) * XH2bis * (AH2O * AH2) ^ (1 / 2) + (1 - KH2O_CO2) * XCO2bis * (ACO2 * AH2O) ^ (1 / 2) + (1 - KH2O_N2) * XN2bis * (AN2 * AH2O) ^ (1 / 2) + (1 - KH2O_CO) * XCObis * (ACO * AH2O) ^ (1 / 2) + grAsuite
\par     grAbis = (1 - KCO_MG) * XMGbis * (ACO * AMG) ^ (1 / 2)
\par     grAsuite = (1 - KCO_CH4) * XCH4bis * (ACO * ACH4) ^ (1 / 2) + (1 - KCO_NH3) * XNH3bis * (ANH3 * ACO) ^ (1 / 2) + grAbis
\par     ArCO = (XCObis) * ACO + (1 - KH2O_CO) * XH2Obis * (AH2O * ACO) ^ (1 / 2) + (1 - KCO_CO2) * XCO2bis * (ACO2 * ACO) ^ (1 / 2) + (1 - KN2_CO) * XN2bis * (AN2 * ACO) ^ (1 / 2) + (1 - KCO_H2) * XH2bis * (ACO * AH2) ^ (1 / 2) + grAsuite
\par     grAbis = (1 - KCH4_MG) * XMGbis * (ACH4 * AMG) ^ (1 / 2)
\par     grAsuite = (1 - KH2_CH4) * XH2bis * (AH2 * ACH4) ^ (1 / 2) + (1 - KCH4_NH3) * XNH3bis * (ANH3 * ACH4) ^ (1 / 2) + grAbis
\par     ArCH4 = (XCH4bis) * ACH4 + (1 - KH2O_CH4) * XH2Obis * (AH2O * ACH4) ^ (1 / 2) + (1 - KCO2_CH4) * XCO2bis * (ACO2 * ACH4) ^ (1 / 2) + (1 - KN2_CH4) * XN2bis * (AN2 * ACH4) ^ (1 / 2) + (1 - KCO_CH4) * XCObis * (ACO * ACH4) ^ (1 / 2) + grAsuite
\par     grAbis = (1 - KNH3_MG) * XMGbis * (ANH3 * AMG) ^ (1 / 2)
\par     grAsuite = (1 - KCH4_NH3) * XCH4bis * (ANH3 * ACH4) ^ (1 / 2) + (1 - KH2_NH3) * XH2bis * (ANH3 * AH2) ^ (1 / 2) + grAbis
\par     ArNH3 = (XNH3bis) * ANH3 + (1 - KH2O_NH3) * XH2Obis * (AH2O * ANH3) ^ (1 / 2) + (1 - KCO2_NH3) * XCO2bis * (ACO2 * ANH3) ^ (1 / 2) + (1 - KN2_NH3) * XN2bis * (AN2 * ANH3) ^ (1 / 2) + (1 - KCO_NH3) * XCObis * (ACO * ANH3) ^ (1 / 2) + grAsuite
\par     grAbis = (1 - KMG_NH3) * XNH3bis * (AMG * ANH3) ^ (1 / 2)
\par     grAsuite = (1 - KCH4_MG) * XCH4bis * (AMG * ACH4) ^ (1 / 2) + (1 - KH2_MG) * XH2bis * (AMG * AH2) ^ (1 / 2) + grAbis
\par     ArMG = (XMGbis) * AMG + (1 - KH2O_MG) * XH2Obis * (AH2O * AMG) ^ (1 / 2) + (1 - KCO2_MG) * XCO2bis * (ACO2 * AMG) ^ (1 / 2) + (1 - KN2_MG) * XN2bis * (AN2 * AMG) ^ (1 / 2) + (1 - KCO_MG) * XCObis * (ACO * AMG) ^ (1 / 2) + grAsuite
\par     
\par     'calculs des param\'e8tres de repulsion et d'attraction de l'equation d'etat, Ai et Bi qui interviennent dans le calcul du coefficient de fugacit\'e9
\par     AH2 = 0.42748 * alphaH2 * (TcH2 ^ 2) / (PcH2 * 100000#) * P / (T ^ 2) 'avec Tr=T/Tc et Pr=P/Pc
\par     BH2 = 0.08664 * TcH2 / (PcH2 * 100000#) * P / (T)
\par     ACO2 = 0.42748 * alphaCO2 * (TcCO2 ^ 2) / (PcCO2 * 100000#) * P / (T ^ 2)
\par     BCO2 = 0.08664 * TcCO2 / (PcCO2 * 100000#) * P / (T)
\par     AN2 = 0.42748 * alphaN2 * (TcN2 ^ 2) / (PcN2 * 100000#) * P / (T ^ 2)
\par     BN2 = 0.08664 * TcN2 / (PcN2 * 100000#) * P / (T)
\par     AH2O = 0.42748 * alphaH2O * (TcH2O ^ 2) / (PcH2O * 100000#) * P / (T ^ 2)
\par     BH2O = 0.08664 * TcH2O / (PcH2O * 100000#) * P / (T)
\par     ACO = 0.42748 * alphaCO * (TcCO ^ 2) / (PcCO * 100000#) * P / (T ^ 2)
\par     BCO = 0.08664 * TcCO / (PcCO * 100000#) * P / (T)
\par     ACH4 = 0.42748 * alphaCH4 * (TcCH4 ^ 2) / (PcCH4 * 100000#) * P / (T ^ 2)
\par     BCH4 = 0.08664 * TcCH4 / (PcCH4 * 100000#) * P / (T)
\par     ANH3 = 0.42748 * alphaNH3 * (TcNH3 ^ 2) / (PcNH3 * 100000#) * P / (T ^ 2)
\par     BNH3 = 0.08664 * TcNH3 / (PcNH3 * 100000#) * P / (T)
\par     AMG = 0.42748 * alphaMG * (TcMG ^ 2) / (PcMG * 100000#) * P / (T ^ 2)
\par     BMG = 0.08664 * TcMG / (PcMG * 100000#) * P / (T)
\par     
\par    'calculs des param\'e8tres de repulsion et d'attraction de l'equation d'etat, A et B qui interviennent dans le calcul du coefficient de fugacit\'e9
\par     grAbis = (XMGbis ^ 2) * AMG + 2 * (1 - KMG_KH2) * XMGbis * XH2bis * (AMG * AH2) ^ (1 / 2) + 2 * (1 - KMG_KCO2) * XMGbis * XCO2bis * (AMG * ACO2) ^ (1 / 2) + 2 * (1 - KMG_KN2
) * XMGbis * XN2bis * (AMG * AN2) ^ (1 / 2) + 2 * (1 - KMG_KH2O) * XMGbis * XH2Obis * (AMG * AH2O) ^ (1 / 2) + 2 * (1 - KMG_KCO) * XMGbis * XCObis * (AMG * ACO2) ^ (1 / 2) + 2 * (1 - KMG_KCH4) * XMGbis * XCH4bis * (AMG * ACH4) ^ (1 / 2) + 2 * (1 - KMG_KNH
3) * XMGbis * XNH3bis * (AMG * ANH3) ^ (1 / 2)
\par     grAsuite = (XCH4bis ^ 2) * ACH4 + (XNH3bis ^ 2) * ANH3 + 2 * (1 - KCO_CH4) * XCH4bis * XCObis * (ACO * ACH4) ^ (1 / 2) + 2 * (1 - KH2O_CH4) * XCH4bis * XH2Obis * (AH2O * ACH4) ^ (1 / 2) + 2 * (1 - KCO2_CH4)
 * XCH4bis * XCO2bis * (ACO2 * ACH4) ^ (1 / 2) + 2 * (1 - KH2_CH4) * XCH4bis * XH2bis * (AH2 * ACH4) ^ (1 / 2) + 2 * (1 - KN2_CH4) * XCH4bis * XN2bis * (AN2 * ACH4) ^ (1 / 2) + 2 * (1 - KCH4_NH3) * XCH4bis * XNH3bis * (ANH3 * ACH4) ^ (1 / 2) + 2 * (1 - KH
2
O_NH3) * XH2Obis * XNH3bis * (ANH3 * AH2O) ^ (1 / 2) + 2 * (1 - KCO2_NH3) * XCO2bis * XNH3bis * (ANH3 * ACO2) ^ (1 / 2) + 2 * (1 - KCO_NH3) * XCObis * XNH3bis * (ANH3 * ACO) ^ (1 / 2) + 2 * (1 - KH2_NH3) * XH2bis * XNH3bis * (ANH3 * AH2) ^ (1 / 2) + 2 * (
1 - KN2_NH3) * XN2bis * XNH3bis * (ANH3 * AN2) ^ (1 / 2) + grAbis
\par     GRA = (XH2Obis ^ 2) * AH2O + (XCO2bis ^ 2) * ACO2 + 2 * (1 - KH2O_CO2) * XH2Obis * XCO2bis * (AH2O * ACO2) ^ (1 / 2) + (XH2bis ^ 2) * AH2 + 2 * (1 - KH2O_H2) * XH2Obis * XH2bis * (AH2O * 
AH2) ^ (1 / 2) + (XN2bis ^ 2) * AN2 + 2 * (1 - KH2O_N2) * XH2Obis * XN2bis * (AH2O * AN2) ^ (1 / 2) + 2 * (1 - KCO2_H2) * XCO2bis * XH2bis * (ACO2 * AH2) ^ (1 / 2) + 2 * (1 - KN2_CO2) * XCO2bis * XN2bis * (ACO2 * AN2) ^ (1 / 2) + 2 * (1 - KN2_H2) * XN2bis
 
* XH2bis * (AN2 * AH2) ^ (1 / 2) + (XCObis ^ 2) * ACO + 2 * (1 - KH2O_CO) * XH2Obis * XCObis * (AH2O * ACO) ^ (1 / 2) + 2 * (1 - KCO_H2) * XCObis * XH2bis * (ACO * AH2) ^ (1 / 2) + 2 * (1 - KN2_CO) * XCObis * XN2bis * (ACO * AN2) ^ (1 / 2) + 2 * (1 - KCO_
CO2) * XCObis * XCO2bis * (ACO * ACO2) ^ (1 / 2) + grAsuite
\par     GRB = XH2Obis * BH2O + XH2bis * BH2 + XCO2bis * BCO2 + XN2bis * BN2 + XCObis * BCO + XNH3bis * BNH3 + XCH4bis * BCH4 + XMGbis * BMG
